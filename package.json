{
  "name": "dam-la",
  "version": "2.14.2",
  "minNativeVersion": "2.1.0",
  "nativeVersion": "2.3.0",
  "private": true,
  "type": "module",
  "description": "dam-la — İngilizce ve genel kültür pop quiz uygulaması (Android + iPhone)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "sync": "node scripts/build.mjs && npx cap sync",
    "android": "node scripts/build.mjs && npx cap sync android && npx cap open android",
    "ios": "node scripts/build.mjs && npx cap sync ios && npx cap open ios",
    "bundle": "node scripts/build.mjs && node scripts/make-update-bundle.mjs",
    "icons": "npx @capacitor/assets generate --iconBackgroundColor '#2f6152' --iconBackgroundColorDark '#2f6152' --splashBackgroundColor '#f4f0e8' --splashBackgroundColorDark '#1f1c22'",
    "version:bump": "npm version patch --no-git-tag-version",
    "build:admin": "node scripts/build-admin.mjs",
    "build:site": "node scripts/build.mjs && node scripts/build-admin.mjs && node scripts/assemble-site.mjs",
    "rules": "node scripts/make-rules.mjs",
    "test:rules": "node scripts/make-rules.mjs && node tests/rules.test.cjs"
  },
  "dependencies": {
    "@capacitor-community/app-icon": "^7.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-updater": "8.54.2",
    "firebase": "^13.2.0",
    "kokoro-js": "^1.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.28.2",
    "targaryen": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "sharp": "^0.35.4"
  }
}
