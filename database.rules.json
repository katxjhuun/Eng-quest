{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "(auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true) || (auth != null && auth.uid == $uid && !newData.exists())",
        "profile": {
          ".write": "auth != null && auth.uid == $uid",
          "shortId": {
            ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^DL-[A-Z0-9]{5}$/)"
          },
          "platform": {
            ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^(android|ios|web)$/)"
          },
          "appVersion": {
            ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().matches(/^[0-9A-Za-z.+-]+$/)"
          },
          "lastOpen": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "stats": {
          ".write": "auth != null && auth.uid == $uid",
          "shortId": {
            ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^DL-[A-Z0-9]{5}$/)"
          },
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "levelIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "correct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "wrong": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "streak": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "opened": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "failed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "badges": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "level": {
            ".validate": "newData.isString() && newData.val().length <= 2 && newData.val().matches(/^(A1|A2|B1|B2|C1|C2)$/)"
          },
          "levelLabel": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(type|quiz|listen|mix)$/)"
          },
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^[a-z]{2,6}$/)"
          },
          "dept": {
            ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^[a-z]{2,20}$/)"
          },
          "theme": {
            ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^[a-z]{2,20}$/)"
          },
          "catXp": {
            "$c": {
              ".validate": "$c.matches(/^[a-z]{2,6}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "live": {
          ".write": "auth != null && auth.uid == $uid",
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^[a-z]{2,6}$/)"
          },
          "catLabel": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "question": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "answer": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "options": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]$/) && newData.isString() && newData.val().length <= 300"
            }
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "status": {
          ".write": "auth != null && auth.uid == $uid",
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 7 && newData.val().matches(/^(online|offline)$/)"
          },
          "last": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "pet": {
          ".write": "auth != null && auth.uid == $uid",
          "species": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
          },
          "stage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "stars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "alive": {
            ".validate": "newData.isBoolean()"
          },
          "hp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "hpMax": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "food": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "foodMax": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "energy": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "energyMax": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "stuffed": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "flow": {
            ".validate": "newData.isBoolean()"
          },
          "roam": {
            ".validate": "newData.isBoolean()"
          },
          "mood": {
            ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^[a-z]{2,12}$/)"
          },
          "streak": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "correct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "answers": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "revives": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "memorial": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "deathCat": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^[a-z]{2,6}$/)"
          },
          "catchUp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "$other": {
            ".validate": false
          }
        },
        "inbox": {
          "$msg": {
            ".write": "auth != null && auth.uid == $uid && !newData.exists()",
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^(message|xp|level|reward|pet)$/)"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
            },
            "cat": {
              ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^[a-z]{2,6}$/)"
            },
            "catLevel": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "level": {
              ".validate": "newData.isString() && newData.val().length <= 2 && newData.val().matches(/^(A1|A2|B1|B2|C1|C2)$/)"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "music": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 300000"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "broadcast": {
              ".validate": "newData.isBoolean()"
            },
            "action": {
              ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^(heal|feed|energy|restore|revive|set|stage|name|species|flow|roam|say|react|reset)$/)"
            },
            "species": {
              ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
            },
            "stage": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "stars": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "food": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "energy": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "emote": {
              ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^[a-z]{2,8}$/)"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "history": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      "$uid": {
        ".write": "(auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true) || (auth != null && auth.uid == $uid && !newData.exists())",
        "$msg": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()",
          "type": {
            ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^(message|xp|level|reward|pet)$/)"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
          },
          "cat": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^[a-z]{2,6}$/)"
          },
          "catLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "level": {
            ".validate": "newData.isString() && newData.val().length <= 2 && newData.val().matches(/^(A1|A2|B1|B2|C1|C2)$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "music": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "broadcast": {
            ".validate": "newData.isBoolean()"
          },
          "action": {
            ".validate": "newData.isString() && newData.val().length <= 12 && newData.val().matches(/^(heal|feed|energy|restore|revive|set|stage|name|species|flow|roam|say|react|reset)$/)"
          },
          "species": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
          },
          "stage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "stars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "hp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "food": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "energy": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "emote": {
            ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^[a-z]{2,8}$/)"
          },
          "on": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          "seenAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000"
          }
        }
      }
    },
    "arena": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$code": {
        ".write": "auth != null && $code.matches(/^DL-[A-Z0-9]{5}$/) && (!data.exists() || data.child('uid').val() == auth.uid) && (!newData.exists() || newData.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'code', 'pet', 'at']) && newData.child('code').val() == $code",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^DL-[A-Z0-9]{5}$/)"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "pet": {
          ".validate": "newData.hasChildren(['species', 'stage', 'role', 'name'])",
          "species": {
            ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
          },
          "stage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "stars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
          },
          "role": {
            ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^(tank|melee|ranger|assassin|support|magician|trickster)$/)"
          },
          "shiny": {
            ".validate": "newData.isBoolean()"
          },
          "coat": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "push": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['sub', 'updatedAt'])",
        "sub": {
          ".validate": "newData.hasChildren(['endpoint', 'keys'])",
          "endpoint": {
            ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().matches(/^https:\\/\\//)"
          },
          "keys": {
            "p256dh": {
              ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^[A-Za-z0-9_=-]+$/)"
            },
            "auth": {
              ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[A-Za-z0-9_=-]+$/)"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "notes": {
          "$n": {
            ".validate": "$n.matches(/^n[0-9]$/) && newData.hasChildren(['at', 'title', 'body'])",
            "at": {
              ".validate": "newData.isNumber()"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "body": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "loud": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admin": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      "labels": {
        "$uid": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    }
  }
}
