            },
            "body": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "loud": {
          ".validate": "newData.isBoolean()"
        },
        "golden": {
          ".validate": "newData.isBoolean()"
        },
        "upd": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feed": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid",
        ".validate": "newData.hasChildren(['uid', 'code', 'kind', 'tier', 'at'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^DL-[A-Z0-9]{5}$/)"
        },
        "kind": {
          ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^(shiny|maxevo|level|maxlevel|boss|stars)$/)"
        },
        "tier": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "species": {
          ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
        },
        "level": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "stage": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "coat": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
        },
        "stars": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "shiny": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "board": {
      ".read": "auth != null",
      ".indexOn": [
        "n"
      ],
      "$code": {
        ".write": "auth != null && $code.matches(/^DL-[A-Z0-9]{5}$/) && (!data.exists() || data.child('uid').val() == auth.uid) && (!newData.exists() || newData.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'code', 'n', 'at']) && newData.child('code').val() == $code",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^DL-[A-Z0-9]{5}$/)"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "species": {
          ".validate": "newData.isString() && newData.val().length <= 6 && newData.val().matches(/^(plant|chick|cat|dog|owl|gecko|whale|doodle|goat)$/)"
        },
        "stage": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "shiny": {
          ".validate": "newData.isBoolean()"
        },
        "coat": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admin": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('admins').child(auth.uid).val() == true",
      "labels": {
        "$uid": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        }
      },
      "tags": {
        "$uid": {
          "$t": {
            ".validate": "$t.matches(/^t[0-7]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    }
  }
}
